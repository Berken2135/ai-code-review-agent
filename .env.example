# Copy to .env and fill in. Never commit .env.

# --- Database (used by docker-compose; the app gets DATABASE_URL built from these) ---
POSTGRES_USER=reviewer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reviewer

# Only needed when running the app outside Docker (make dev / make migrate / pytest-free local runs).
DATABASE_URL=postgresql+psycopg://reviewer:change-me@localhost:5432/reviewer

# --- GitHub ---
# Personal Access Token with "pull requests: read & write" (fine-grained) or "repo" scope.
GITHUB_TOKEN=
# Shared secret configured on the GitHub webhook (Settings -> Webhooks -> Secret).
GITHUB_WEBHOOK_SECRET=

# --- API ---
# Bearer token for GET /runs. Required: while empty, /runs answers 503.
# Send it as: Authorization: Bearer <token>
RUNS_API_TOKEN=

# --- LLM ---
# openai | anthropic
LLM_PROVIDER=openai
# Leave empty for the provider default (openai: gpt-4o-mini, anthropic: claude-sonnet-5).
LLM_MODEL=
# Per-request timeout for LLM calls, in seconds.
LLM_TIMEOUT_SECONDS=60
# Only the key for the selected provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Misc ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
